# ================================================
# TORUS AI - Environment Variables
# Copy this file to .env.local and fill in values
# ================================================

# Firebase
# Get client values from: Firebase Console -> Project settings -> General -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Get admin credentials from: Firebase Console -> Project settings -> Service accounts
# Paste the full service account JSON on one line for production hosting.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}

# Groq AI
# Get from: console.groq.com -> API Keys
# Free tier: 14,400 requests/day
GROQ_API_KEY=gsk_your_key_here
# You can add up to 3 fallback keys which will be used automatically on rate limit.
GROQ_API_KEY_2=gsk_your_second_key_here
GROQ_API_KEY_3=gsk_your_third_key_here
GROQ_API_KEY_4=gsk_your_fourth_key_here

# Gemini fallback
# Get from: aistudio.google.com -> API Keys
GEMINI_API_KEY=AIzaSy...

# SearXNG
# For local development: docker run -p 8080:8080 searxng/searxng
# For production: deploy to Railway or another container host.
SEARXNG_BASE_URL=http://localhost:8080

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MCP (local stdio server only — see mcp/README.md)
# TORUS_BASE_URL=http://localhost:3000

# Resend email, optional
# Get from: resend.com -> API Keys
RESEND_API_KEY=re_your_key_here
